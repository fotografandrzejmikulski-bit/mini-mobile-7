# Copy to .env on the deployment host; never commit the real file.
# Pin the tested Open5GS release; do not silently track a floating latest tag.
OPEN5GS_VERSION=v2.8.0
MONGO_DB=open5gs
OPEN5GS_DB_URI=mongodb://mongodb/open5gs
MANAGEMENT_CIDR=10.30.0.0/24
CORE_CIDR=10.10.0.0/24
UE_CIDR=10.20.0.0/24
IMS_CIDR=10.40.0.0/24
LAB_PLMN_MCC=001
LAB_PLMN_MNC=01
LAB_APN=internet
LAB_DNN=internet
